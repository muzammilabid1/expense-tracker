<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verify your Northstar account</title>
  </head>
  <body style="margin:0;background:#f2f5f4;padding:32px 16px;font-family:Arial,Helvetica,sans-serif;color:#17231f;">
    <table role="presentation" style="width:100%;max-width:560px;margin:0 auto;border-collapse:collapse;background:#fff;border:1px solid #e0e8e4;border-radius:16px;">
      <tr><td style="padding:36px 32px;">
        <p style="margin:0 0 10px;color:#318365;font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;">Northstar</p>
        <h1 style="margin:0 0 14px;font-size:24px;line-height:1.3;">Verify your email</h1>
        <p style="margin:0;color:#52615b;font-size:15px;line-height:1.6;">Enter this code to verify your email and finish creating your account.</p>
        <p style="margin:26px 0;padding:18px;border-radius:12px;background:#f1f8f4;text-align:center;color:#1d513e;font-size:32px;font-weight:700;letter-spacing:8px;"><%= code %></p>
        <p style="margin:0;color:#52615b;font-size:14px;line-height:1.6;">This code expires in <%= expiresMinutes %> minutes. If you didn’t request an account, you can ignore this email.</p>
        <p style="margin:28px 0 0;color:#87938e;font-size:12px;">Northstar Personal Finance</p>
      </td></tr>
    </table>
  </body>
</html>
