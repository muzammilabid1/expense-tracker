# Copy this file to .env and replace the placeholder with your local PostgreSQL password.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/expense_tracker

# Replace this with a long, random secret in your local .env file.
JWT_SECRET=replace_with_a_long_random_secret

# Local frontend origin. Update this if the frontend runs on a different origin.
FRONTEND_ORIGIN=http://localhost:5173

# SMTP settings used to email email-change verification codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_app_password
EMAIL_FROM=Northstar <your_email@example.com>
